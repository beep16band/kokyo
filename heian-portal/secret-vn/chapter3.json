    {
      "scene_id": "C03-S09",
      "chapter_id": "C03",
      "title": "千年前の約束の始まり",
      "background_ids": [
        "BG16",
        "BG22"
      ],
      "characters": [
        "幼いことは",
        "幼い真尋",
        "茜",
        "湊"
      ],
      "event_tags": [
        "flashback",
        "chapter-transition"
      ],
      "dialogue_status": "全シーン新規統合稿収録済み・第2稿逐語転記ではない（教師の台本確認待ち）",
      "screenplay_source": "本チャットの第1〜第7章本文",
      "complete_when": "会話・演出を最後まで再生し、必須試練がある場合は全問正解",
      "quiz_ids": [],
      "script": [
        {
          "kind": "narration",
          "speaker": "地の文",
          "text": "過去の書庫。幼いことはと真尋が古い和歌を読む。"
        },
        {
          "kind": "dialogue",
          "speaker": "ことは",
          "text": "遠い昔の人の気持ちを、今でも読めるってすごいよね。"
        },
        {
          "kind": "dialogue",
          "speaker": "真尋",
          "text": "難しい字ばかりだけどな。"
        },
        {
          "kind": "dialogue",
          "speaker": "ことは",
          "text": "私は歌を集めて、誰にも忘れられないようにしたい。"
        },
        {
          "kind": "dialogue",
          "speaker": "真尋",
          "text": "じゃあ、俺も手伝う。約束だ。"
        },
        {
          "kind": "narration",
          "speaker": "地の文",
          "text": "二人は小指を絡めて笑う。巻物の文字が突然黒くにじむ。"
        },
        {
          "kind": "dialogue",
          "speaker": "忘れの主",
          "text": "守るためには、忘れねばならぬ。"
        },
        {
          "kind": "dialogue",
          "speaker": "茜",
          "text": "さっきの幸せそうな二人が、どうして……。"
        },
