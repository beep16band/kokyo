      "complete_when": "会話・演出を最後まで再生し、必須試練がある場合は全問正解",
      "quiz_ids": [],
      "script": [
        {
          "kind": "narration",
          "speaker": "地の文",
          "text": "多摩川のほとり。布をさらす場所に人はなく、水音も鈍い。"
        },
        {
          "kind": "dialogue",
          "speaker": "若者",
          "text": "さら……さら……。誰が、いとしかったのだろう。"
        },
        {
          "kind": "dialogue",
          "speaker": "茜",
          "text": "「多摩川に」の東歌……。"
        },
        {
          "kind": "dialogue",
          "speaker": "湊",
          "text": "この歌は、作者の名前が分からないんだよな。"
        },
        {
          "kind": "dialogue",
          "speaker": "茜",
          "text": "うん。でも、歌は残ってる。"
        },
        {
          "kind": "narration",
          "speaker": "地の文",
          "text": "若者の影から歌の文字が立ち上る。"
        }
      ],
      "visual_stage": "background:BG20; characters:茜,湊,東歌の若者; events:river-frozen",
      "screenplay_version": "v1.1",
