      "screenplay_source": "本チャットの第1〜第7章本文",
      "complete_when": "会話・演出を最後まで再生し、必須試練がある場合は全問正解",
      "quiz_ids": [],
      "script": [
        {
          "kind": "narration",
          "speaker": "地の文",
          "text": "回廊の壁に、額田王から藤原定家まで異なる時代の歌人が描かれている。"
        },
        {
          "kind": "dialogue",
          "speaker": "湊",
          "text": "おかしい。飛鳥時代の歌人と、鎌倉時代の歌人が同じ場所にいる。"
        },
        {
          "kind": "dialogue",
          "speaker": "茜",
          "text": "ここは平安京そのものじゃないのかな。"
        },
        {
          "kind": "dialogue",
          "speaker": "番人の声",
          "text": "そのとおり。ここは歌に残された心が集まる場所。"
        },
        {
          "kind": "dialogue",
          "speaker": "湊",
          "text": "誰だ！"
        },
        {
          "kind": "dialogue",
          "speaker": "番人の声",
          "text": "先へ進めば、記録が答えるでしょう。"
        },
        {
          "kind": "narration",
          "speaker": "地の文",
          "text": "書庫の扉が開く。"
        }
      ],
      "visual_stage": "background:BG22; characters:茜,湊; events:era-paradox",
      "screenplay_version": "v1.1",
      "shot_cues": [],
