      "quiz_ids": [],
      "script": [
        {
          "kind": "narration",
          "speaker": "地の文",
          "text": "香具山の衣が揺れ、春の桜が散って季節が進む。"
        },
        {
          "kind": "dialogue",
          "speaker": "持統天皇",
          "text": "夏が来たらしい。そう感じたのですね。"
        },
        {
          "kind": "dialogue",
          "speaker": "茜",
          "text": "見た景色から、季節が変わったことを知ったんです。"
        },
        {
          "kind": "dialogue",
          "speaker": "持統天皇",
          "text": "この庭では、異なる時代の歌も同じ場所に集まります。"
        },
        {
          "kind": "dialogue",
          "speaker": "湊",
          "text": "平安なのに、違う時代の歌人がいる理由……。"
        },
        {
          "kind": "dialogue",
          "speaker": "持統天皇",
          "text": "川の向こうに、書庫があります。"
        },
        {
          "kind": "narration",
          "speaker": "地の文",
          "text": "「夏」の札が光り、川への道が開く。"
        }
      ],
      "visual_stage": "background:BG19; characters:持統天皇,茜,湊; events:season-recovery",
