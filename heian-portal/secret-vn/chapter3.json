      "chapter_id": "C03",
      "title": "言の葉の書庫",
      "background_ids": [
        "BG22"
      ],
      "characters": [
        "茜",
        "湊",
        "記憶の番人"
      ],
      "event_tags": [
        "memory-archive"
      ],
      "dialogue_status": "全シーン新規統合稿収録済み・第2稿逐語転記ではない（教師の台本確認待ち）",
      "screenplay_source": "本チャットの第1〜第7章本文",
      "complete_when": "会話・演出を最後まで再生し、必須試練がある場合は全問正解",
      "quiz_ids": [],
      "script": [
        {
          "kind": "narration",
          "speaker": "地の文",
          "text": "無数の巻物が浮く巨大な書庫。白い装束の記憶の番人が現れる。"
        },
        {
          "kind": "dialogue",
          "speaker": "番人",
          "text": "言の葉の庭は、歌が読み継がれるたびに記憶を集めてきました。"
        },
        {
          "kind": "dialogue",
          "speaker": "茜",
          "text": "だから、未来の歌人の記憶もここにあるんだね。"
        },
        {
          "kind": "dialogue",
          "speaker": "番人",
          "text": "歌人本人が生きているのではありません。歌に託された記憶の姿です。"
        },
        {
          "kind": "dialogue",
          "speaker": "湊",
          "text": "ことはは？　あの子も……。"
        },
        {
          "kind": "dialogue",
          "speaker": "番人",
          "text": "あの少女は、すでに役目を終えたはずの記録。"
        },
        {
          "kind": "dialogue",
          "speaker": "茜",
          "text": "なのに、今も私たちを助けてくれた。"
        },
        {
          "kind": "dialogue",
          "speaker": "番人",
          "text": "真相は、最奥の巻物にあります。"
        },
        {
          "kind": "narration",
          "speaker": "地の文",
          "text": "橘の花の紋がある巻物が開かれる。"
        }
      ],
      "visual_stage": "background:BG22; characters:茜,湊,記憶の番人; events:memory-archive",
      "screenplay_version": "v1.1",
