      "script": [
        {
          "kind": "narration",
          "speaker": "地の文",
          "text": "【任意】雪をいただく富士。山部赤人の記憶が長歌と反歌の巻物を示す。"
        },
        {
          "kind": "dialogue",
          "speaker": "山部赤人",
          "text": "山をたたえる長い歌と、それに添える短い歌があります。"
        },
        {
          "kind": "dialogue",
          "speaker": "湊",
          "text": "同じ富士でも、言葉の重ね方が違うんですね。"
        },
        {
          "kind": "dialogue",
          "speaker": "茜",
          "text": "短い方は「田子の浦ゆ」の歌だ。"
        },
        {
          "kind": "dialogue",
          "speaker": "山部赤人",
          "text": "二つを比べてもよいし、先へ進んでも構いません。"
        },
        {
          "kind": "narration",
          "speaker": "地の文",
          "text": "OPTIONAL QUIZ 2問。正否・未実施にかかわらず本編は解放される。"
