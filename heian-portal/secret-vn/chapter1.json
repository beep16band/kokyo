  "poems": {
    "w03": {
      "author": "額田王（ぬかたのおおきみ）",
      "collection": "万葉集 巻4・488",
      "text": "君待つと 我が恋ひ居れば 我が屋戸の すだれ動かし 秋の風吹く",
      "reading": "きみまつと あがこいおれば わがやどの すだれうごかし あきのかぜふく",
      "meaning": "あなたを待ち、恋しく思っていると、私の家のすだれを動かして秋の風が吹く。",
      "note": "訓読には「あが／わが」「屋戸／宿」など表記差がある。この画面は現行ポータルの表記を継承。作者は飛鳥時代の歌人。庭や人物との会話は創作。",
      "source": "https://manyo-hyakka.pref.nara.jp/db/detailLink?cls=db_manyo&pkey=488",
      "sourceName": "奈良県立万葉文化館・万葉百科"
    },
    "w12": {
      "author": "小野小町（おののこまち）",
      "collection": "古今和歌集 巻12・恋歌二・552",
      "text": "思ひつつ 寝ればや人の 見えつらむ 夢と知りせば 覚めざらましを",
      "reading": "おもいつつ ぬればやひとの みえつらん ゆめとしりせば さめざらましを",
      "meaning": "あの人を思いながら寝たので、夢にあの人が現れたのだろうか。夢だと分かっていたなら、目覚めずにいたかったのに。",
      "note": "「せば〜まし」は、実際とは違うことを想定する反実仮想。相手が自分を思っている証拠とは言えない。現代語訳は本作独自の説明。",
      "source": "https://crd.ndl.go.jp/reference/entry/index.php?id=2000025676&page=man_view",
      "sourceName": "国立国会図書館・レファレンス協同データベース"
    }
  },
