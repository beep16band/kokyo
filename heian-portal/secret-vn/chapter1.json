      "script": [
        {
          "kind": "narration",
          "speaker": "地の文",
          "text": "風の止まった宮廷。簾の前で、顔の見えない額田王の記憶が座っている。"
        },
        {
          "kind": "dialogue",
          "speaker": "額田王",
          "text": "誰も来ない。簾が動いても……私は誰を待ったのか。"
        },
        {
          "kind": "dialogue",
          "speaker": "茜",
          "text": "額田王さん。前に読んだ歌を覚えていますか。"
        },
        {
          "kind": "dialogue",
          "speaker": "湊",
          "text": "「君待つと我が恋ひ居れば」。ここに答えがある。"
        },
        {
          "kind": "dialogue",
          "speaker": "額田王",
          "text": "私は……何を恋しく思っていたのか。"
        },
        {
          "kind": "narration",
          "speaker": "地の文",
          "text": "歌集に額田王の歌が浮かび、四つの問いが灯る。"
        }
      ],
      "visual_stage": "background:BG05; characters:茜,湊,額田王; events:poet-shadow",
