      "script": [
        {
          "kind": "narration",
          "speaker": "地の文",
          "text": "桜の花びらが流れ、夢の霧が晴れてゆく。"
        },
        {
          "kind": "dialogue",
          "speaker": "小野小町",
          "text": "夢だと知っていれば覚めずにいたかった……私はそれほど恋しく思ったのですね。"
        },
        {
          "kind": "dialogue",
          "speaker": "茜",
          "text": "会えた夢も、思っていた気持ちも、歌には残っています。"
        },
        {
          "kind": "dialogue",
          "speaker": "小野小町",
          "text": "ありがとう。ほかの歌人の心も助けてあげてください。"
        },
        {
          "kind": "narration",
          "speaker": "地の文",
          "text": "「夢」の札が光る。五つの扉と、その先へ続く回廊が現れる。"
        },
        {
          "kind": "dialogue",
          "speaker": "湊",
          "text": "前にも五つの扉があった。でも、もっと奥がある。"
        },
        {
          "kind": "dialogue",
          "speaker": "声",
          "text": "橘の花を、守れ。"
        },
        {
          "kind": "dialogue",
          "speaker": "茜",
          "text": "……橘？　それは私の苗字……。"
        },
        {
          "kind": "narration",
          "speaker": "地の文",
          "text": "扉の向こうで梅の香りがかすかに漂った。"
        }
      ],
      "visual_stage": "background:BG08,BG09; characters:茜,湊,小野小町; events:memory-recovery,gate",
