      "script": [
        {
          "kind": "narration",
          "speaker": "地の文",
          "text": "風が戻り、簾がさらりと揺れた。額田王の顔に柔らかな明かりが差す。"
        },
        {
          "kind": "dialogue",
          "speaker": "額田王",
          "text": "ああ。私は、あの人を待ち、恋しく思っていたのですね。"
        },
        {
          "kind": "dialogue",
          "speaker": "茜",
          "text": "秋風に簾が揺れた、その一瞬が歌に残っていたんです。"
        },
        {
          "kind": "dialogue",
          "speaker": "額田王",
          "text": "ありがとう。私の思いを取り戻してくれて。"
        },
        {
          "kind": "dialogue",
          "speaker": "湊",
          "text": "ことはを探しているんです。知りませんか。"
        },
        {
          "kind": "dialogue",
          "speaker": "額田王",
          "text": "桜の向こうへ。夢から覚められない者がいます。"
        },
        {
          "kind": "narration",
          "speaker": "地の文",
          "text": "「待」と刻まれた札が現れ、次の道を指し示した。"
        }
      ],
      "visual_stage": "background:BG06; characters:茜,湊,額田王; events:poet-recovery",
