          "akane": "surprised",
          "minato": "surprised"
        },
        "poem": true,
        "sid": "e5-base5"
      },
      {
        "who": "湊",
        "text": "「なかりけり」は、ないのだなあという気づき。「ない」のは花と紅葉だね。",
        "bg": "shore",
        "mood": "thoughtful",
        "emotions": {
          "akane": "curious",
          "minato": "thoughtful"
        },
        "sid": "e5-base7"
      },
      {
        "who": "ことは",
        "text": "何もないのではないわ。苫屋と秋の夕暮れは、ここにある。",
        "bg": "shore",
        "mood": "thoughtful",
        "emotions": {
          "akane": "curious",
          "minato": "thoughtful"
        },
        "sid": "e5-base8"
      },
      {
        "who": "茜",
        "text": "この歌の「ない」は、何を見えるようにしている？",
        "bg": "shore",
        "mood": "thoughtful",
        "emotions": {
          "akane": "thoughtful",
          "minato": "thoughtful"
        },
        "choices": [
          [
            "花と紅葉の華やかさを思い起こさせ、苫屋と夕暮れを際立たせる",
            "「花も紅葉も」と名を挙げて否定するため、読者の心には華やかな景色も浮かびます。その上で「浦の苫屋」「秋の夕暮」が残り、静けさや余情を感じる読みにつながります。"
          ],
          [
            "全てが消えて、何の景色も価値も残らない",
            "「浦の苫屋」「秋の夕暮」は原文に残っています。「ない」の対象を花と紅葉に確かめ、残る景色とどう対照になるか読みましょう。"
          ]
        ],
        "sid": "e5-base10"
      },
      {
        "who": "湊",
        "text": "業平は色を広げた。定家は、華やかなものを描かないことで景色を感じさせるんだ。",
        "bg": "shore",
        "mood": "curious",
        "emotions": {
          "akane": "thoughtful",
          "minato": "curious"
        },
        "sid": "e5-base11"
      },
      {
        "who": "語り",
        "text": "戸に、ことは宛ての手紙が挟まっていた。まだ封が切られていない。",
        "bg": "shore",
        "mood": "curious",
        "emotions": {
          "akane": "thoughtful",
          "minato": "curious"
        },
        "sid": "e5-base14"
      },
      {
        "who": "ことは",
        "text": "あの人は、もう来ない。読んだら、本当の別れになると思って……。",
        "bg": "shore",
        "mood": "curious",
        "emotions": {
          "akane": "thoughtful",
          "minato": "curious"
        },
        "sid": "e5-base15"
      },
      {
        "who": "ことは",
        "text": "誰も去らない世界なら、失わずに済むと思った。霧は、私が読まずにいた言葉から生まれたの。",
        "bg": "shore",
        "mood": "curious",
        "emotions": {
          "akane": "thoughtful",
          "minato": "curious"
        },
        "sid": "e5-base17"
      },
      {
        "who": "語り",
        "text": "ことはが封を切った。「花のない日も、あなたと見た庭を、私は覚えています」。短い一行だった。",
        "bg": "shore",
        "mood": "serious",
        "emotions": {
          "akane": "thoughtful",
          "minato": "serious"
        },
        "sid": "e5-base21"
      },
      {
        "who": "語り",
        "text": "ことはは静かに泣いた。茜も言葉を足さず、三人で波の音を聞いた。",
        "bg": "shore",
        "mood": "serious",
        "emotions": {
          "akane": "thoughtful",
          "minato": "serious"
        },
        "sid": "e5-base23"
      },
      {
        "who": "茜",
        "text": "華やかでなくても、残るものを大切にする。わびやさびにも、つながる気がする。",
        "bg": "shore",
        "mood": "curious",
        "emotions": {
          "akane": "curious",
          "minato": "serious"
        },
        "sid": "e5-base24"
      },
      {
        "who": "ことは",
        "text": "後世、この歌にはわび茶の心も重ねられたわ。でも、それだけで決めず、苫屋と夕暮れの言葉へ戻ってね。",
        "bg": "shore",
        "mood": "serious",
        "emotions": {
          "akane": "curious",
          "minato": "serious"
        },
        "sid": "e5-base25"
      },
      {
        "who": "語り",
        "text": "細い月が雲に隠れ、また現れた。歌の本文にはない、この旅の空だった。",
        "bg": "shore",
        "mood": "thoughtful",
        "emotions": {
          "akane": "curious",
          "minato": "thoughtful"
        },
        "sid": "e5-base28"
      },
      {
        "who": "ことは",
        "text": "満月だけでなく、十六夜や立待月にも名前がある。欠けていく月も、待ち望まれていたのね。",
        "bg": "shore",
        "mood": "thoughtful",
        "emotions": {
          "akane": "thoughtful",
          "minato": "thoughtful"
        },
        "sid": "e5-base30"
      },
      {
        "who": "ことは",
        "text": "後の『徒然草』にも、盛りの花や曇りのない月だけがよいのか、と問う言葉があるわ。時代や人によって、美の見方も違うの。",
        "bg": "shore",
        "mood": "curious",
        "emotions": {
          "akane": "thoughtful",
          "minato": "curious"
        },
        "sid": "e5-base32"
      },
      {
        "who": "茜",
        "text": "帰ったら、この歌をどう伝えたい？",
        "bg": "shore",
        "mood": "curious",
        "emotions": {
          "akane": "curious",
          "minato": "curious"
        },
        "choices": [
          [
            "「ない」を根拠に、残る景色と心に浮かぶ華やかさを読む",
            "本文に戻った鑑賞です。余情、わび・さびとのつながりは読みを深める視点。ただし後世のわび茶や『徒然草』と、定家の作歌時代を同一視しないことも大切です。"
          ],
          [
            "わび・さびの歌だから、本文は読まなくてよい",
            "美の用語だけでは何が美しいのか説明できません。「花も紅葉も」の否定と「浦の苫屋」「秋の夕暮」の取り合わせを根拠に、自分の感じた美しさを語りましょう。"
          ]
        ],
        "sid": "e5-base33"
      },
      {
        "who": "語り",
        "text": "「待つ」「願う」「変わる」「見立てる」に、「残る」が加わった。戸の隙間で白いカーテンが揺れる。",
        "bg": "shore",
        "mood": "curious",
        "emotions": {
          "akane": "curious",
          "minato": "curious"
        },
        "sid": "e5-base34"
      },
      {
        "who": "茜",
        "text": "ことはも、一緒に。",
        "bg": "shore",
        "mood": "surprised",
        "emotions": {
          "akane": "surprised",
          "minato": "curious"
        },
        "sid": "e5-base36"
      },
      {
        "who": "ことは",
        "text": "私はここで続きを書く。もう、読まずに待つのはやめる。二人とも、ありがとう。",
        "bg": "shore",
        "mood": "curious",
        "emotions": {
          "akane": "surprised",
          "minato": "curious"
        },
        "sid": "e5-base37"
      },
      {
        "who": "語り",
        "text": "途切れたチャイムが鳴り、二人は教室へ戻った。机の上に、白い便箋がある。",
        "bg": "classroom",
        "mood": "surprised",
        "emotions": {
          "akane": "surprised",
          "minato": "surprised"
        },
        "sid": "e5-base40"
      },
      {
        "who": "湊",
        "text": "あとで、じゃなくて今話す。引っ越すのは寂しい。でも、向こうで見た景色も君に送りたい。",
        "bg": "classroom",
        "mood": "serious",
        "emotions": {
          "akane": "thoughtful",
          "minato": "serious"
        },
        "sid": "e5-base42"
      },
      {
        "who": "茜",
        "text": "同じ毎日じゃなくなっても、湊の言葉は読めるね。",
        "bg": "classroom",
        "mood": "hopeful",
        "emotions": {
          "akane": "hopeful",
          "minato": "serious"
        },
        "sid": "e5-base43"
      },
      {
        "who": "語り",
        "text": "茜は友達への手紙に「会いたいです」と書いた。もう消さなかった。",
        "bg": "classroom",
        "mood": "serious",
        "emotions": {
          "akane": "hopeful",
          "minato": "serious"
        },
        "sid": "e5-base44"
      },
      {
        "who": "語り",
        "text": "数週間後。引っ越した湊から、曇った空と窓辺の写真が届いた。",
        "bg": "classroom",
        "mood": "calm",
        "emotions": {
          "akane": "thoughtful",
          "minato": "calm"
        },
        "sid": "e5-extra44-7"
      },
      {
        "who": "湊の手紙",
        "text": "新しい教室の窓です。まだ寂しい。でも、隣の人が町の話をしてくれました。次に会ったら、一緒に歩こう。",
        "bg": "classroom",
        "mood": "calm",
        "emotions": {
          "akane": "hopeful",
          "minato": "calm"
        },
        "sid": "e5-extra44-8"
      },
      {
        "who": "語り",
        "text": "茜は古い歌集を開いた。五首は消えていない。余白に、二人が残した言葉があった。",
        "bg": "classroom",
        "mood": "calm",
        "emotions": {
          "akane": "calm",
          "minato": "calm"
        },
        "sid": "e5-extra44-10"
      },
      {
        "who": "語り",
        "text": "感じたことは鑑賞ノートへ。書かずに結末へ進んでも大丈夫。",
        "bg": "classroom",
        "mood": "serious",
        "emotions": {
          "akane": "hopeful",
          "minato": "serious"
        },
        "note": true,
        "sid": "e5-base45"
      },
      {
        "who": "茜",
        "text": "同じ景色も、読む前とは違って見える。今度は、あなたの言葉を残してね。",
        "bg": "classroom",
        "mood": "hopeful",
        "emotions": {
          "akane": "hopeful",
          "minato": "serious"
        },
        "end": true,
        "sid": "e5-base46"
      }
    ]
  }
